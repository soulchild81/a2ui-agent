A2UI_MODE=mock
A2UI_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# LLM mode uses an OpenAI-compatible Chat Completions endpoint.
LLM_PROVIDER=api
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Set LLM_PROVIDER=codex_cli to use the locally authenticated Codex CLI.
CODEX_CLI_EXECUTABLE=codex
CODEX_CLI_MODEL=
CODEX_CLI_TIMEOUT_SECONDS=120

